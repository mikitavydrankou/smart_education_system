# Optional. The application works with verified lesson explanations when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative provider. Used only when OPENAI_API_KEY is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional server-side Polish narration (uses the provider key above).
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2.1-flash
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Leave empty for the provider-specific default Polish voice.
TTS_VOICE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
